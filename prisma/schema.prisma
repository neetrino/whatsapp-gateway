generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  QR_REQUIRED
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum OutboundIdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  OUTCOME_UNKNOWN
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
}

enum GroupApiOperationType {
  CREATE_GROUP
  ADD_PARTICIPANTS
}

enum GroupApiOperationStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  OUTCOME_UNKNOWN
}

enum WhatsappAccountMode {
  SEND_ONLY
  MESSENGER
}

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(0)
  singleton      Int      @unique @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("admins")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiTokens        ApiToken[]
  whatsappAccounts WhatsappAccount[]

  @@map("projects")
}

model WhatsappAccount {
  id                 String              @id @default(cuid())
  projectId          String
  label              String
  mode               WhatsappAccountMode @default(SEND_ONLY)
  sessionName        String              @unique
  status             SessionStatus       @default(QR_REQUIRED)
  phoneNumber        String?
  isActive           Boolean             @default(true)
  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  project                   Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  logs                      OutboundMessageLog[]
  groupApiOperations        GroupApiOperation[]
  outboundIdempotencyKeys   OutboundMessageIdempotency[]

  @@index([projectId])
  @@index([projectId, isActive])
  @@map("whatsapp_accounts")
}

model ApiToken {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  last4       String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("api_tokens")
}

model OutboundMessageLog {
  id                String        @id @default(cuid())
  whatsappAccountId String
  requestId         String        @unique
  chatId            String
  messageType       MessageType   @default(TEXT)
  status            MessageStatus @default(PENDING)
  wahaMessageId     String?
  errorCode         String?
  errorMessage      String?
  idempotencyKey    String?
  requestHash       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@index([whatsappAccountId, createdAt])
  @@index([whatsappAccountId, idempotencyKey, requestHash])
  @@map("outbound_message_logs")
}

model OutboundMessageIdempotency {
  id                String                    @id @default(cuid())
  whatsappAccountId String
  idempotencyKey    String
  requestHash       String
  status            OutboundIdempotencyStatus @default(PROCESSING)
  requestId         String?
  messageId         String?
  wahaMessageId     String?
  sentAt            DateTime?
  errorCode         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@unique([whatsappAccountId, idempotencyKey])
  @@index([whatsappAccountId, createdAt])
  @@map("outbound_message_idempotency")
}

model GroupApiOperation {
  id                 String                  @id @default(cuid())
  whatsappAccountId  String
  operationType      GroupApiOperationType
  idempotencyKey     String
  requestHash        String
  status             GroupApiOperationStatus @default(PROCESSING)
  groupId            String?
  normalizedResponse Json?
  errorCode          String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@unique([whatsappAccountId, idempotencyKey])
  @@index([whatsappAccountId, createdAt])
  @@map("group_api_operations")
}
