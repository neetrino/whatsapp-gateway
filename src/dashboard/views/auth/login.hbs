<section class="card">
  <div class="auth-brand">
    <span class="brand-mark" aria-hidden="true"></span>
    <div class="auth-brand-text">
      <h1>Sign in</h1>
      <p class="meta">Neetrino Internal Chat Gateway</p>
    </div>
  </div>
  <p class="meta">Admin access only. This is not a public WhatsApp login page.</p>
  <p class="meta">Contact: <a href="mailto:info@neetrino.com">info@neetrino.com</a></p>
  {{#if loginError}}
    <p class="form-error" role="alert">{{loginError}}</p>
  {{/if}}
  <form method="post" action="/login" class="form">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <label>
      Email
      <input type="email" name="email" autocomplete="username" required />
    </label>
    <label>
      Password
      <input type="password" name="password" autocomplete="current-password" required minlength="8" />
    </label>
    <button type="submit" class="primary">Sign in</button>
  </form>
</section>
