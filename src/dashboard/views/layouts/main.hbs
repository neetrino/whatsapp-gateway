<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} — Neetrino Internal Chat Gateway</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        Neetrino Internal Chat Gateway
      </div>
      <nav class="nav">
        {{#if currentAdmin}}
          <a href="/dashboard" class="{{#ifEquals active 'overview'}}active{{/ifEquals}}">Dashboard</a>
          <a href="/projects" class="{{#ifEquals active 'projects'}}active{{/ifEquals}}">Projects</a>
          <a href="/system" class="{{#ifEquals active 'system'}}active{{/ifEquals}}">System / Health</a>
        {{/if}}
      </nav>
      <div class="user-block">
        {{#if currentAdmin}}
          <span class="user-name">{{currentAdmin.email}}</span>
          <form method="post" action="/logout" class="inline">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <button type="submit" class="link-button">Sign out</button>
          </form>
        {{/if}}
      </div>
    </header>
    <main class="container">
      {{{body}}}
    </main>
  </body>
</html>
