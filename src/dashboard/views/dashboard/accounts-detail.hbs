<section>
  <div class="page-header">
    <h1>{{account.label}}</h1>
    <span class="status status-{{account.status}}">{{account.status}}</span>
  </div>
  <p class="meta">
    Mode <code>{{account.mode}}</code>
    {{#ifEquals account.mode "MESSENGER"}}
      · stored only; Messenger is not enabled in Phase 1
    {{/ifEquals}}
    · Session <code>{{account.sessionName}}</code>
    {{#if account.phoneNumber}} · Phone: {{account.phoneNumber}}{{/if}}
    · {{#if account.isActive}}Active{{else}}Inactive{{/if}}
  </p>

  <div class="actions">
    <a href="/projects/{{projectId}}/accounts/{{account.id}}/qr" class="primary">Show QR</a>
    {{#if account.isActive}}
      <form method="post" action="/projects/{{projectId}}/accounts/{{account.id}}/deactivate" class="inline">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit" class="danger">Deactivate</button>
      </form>
    {{else}}
      <form method="post" action="/projects/{{projectId}}/accounts/{{account.id}}/activate" class="inline">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit">Activate</button>
      </form>
    {{/if}}
    <form method="post" action="/projects/{{projectId}}/accounts/{{account.id}}/restart" class="inline">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      <button type="submit">Restart session</button>
    </form>
    <form method="post" action="/projects/{{projectId}}/accounts/{{account.id}}/stop" class="inline">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      <button type="submit" class="danger">Stop session</button>
    </form>
    <form method="post" action="/projects/{{projectId}}/accounts/{{account.id}}/unlink" class="inline">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      <button type="submit" class="danger">Unlink</button>
    </form>
    <a href="/projects/{{projectId}}">Back to project</a>
  </div>
</section>
