<section>
  <div class="page-header">
    <h1>Projects</h1>
    <a href="/projects/new" class="primary">New project</a>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th class="col-center">Slug</th>
        <th class="col-center">Status</th>
        <th class="col-center">Accounts</th>
        <th class="col-center">Tokens</th>
      </tr>
    </thead>
    <tbody>
      {{#each projects}}
        <tr class="click-row">
          <td>
            <a href="/projects/{{this.id}}" class="click-row__link">{{this.name}}</a>
          </td>
          <td class="col-center"><code>{{this.slug}}</code></td>
          <td class="col-center">{{#if this.isActive}}Active{{else}}Inactive{{/if}}</td>
          <td class="col-center">{{this.accountCount}}</td>
          <td class="col-center">{{this.tokenCount}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>
