NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Absolute path so Prisma CLI and the app open the same file.
# Docker compose overrides this to file:/app/data/gateway.db
DATABASE_URL=file:/absolute/path/to/data/gateway.db

# Each secret must be at least 32 characters of high-entropy random data.
COOKIE_SECRET=replace-with-32+char-random-string
JWT_SECRET=replace-with-32+char-random-string
TOKEN_PEPPER=replace-with-32+char-random-string

WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=replace-with-waha-api-key
WAHA_WEBHOOK_SECRET=replace-with-webhook-secret-32-chars-min
GATEWAY_INTERNAL_URL=http://gateway:3000

# Seeded on process start. Password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
