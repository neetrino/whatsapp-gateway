# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Production URL for this deployment (chat.neetrino.com). For local dev, override with http://localhost:3000.
APP_URL=https://chat.neetrino.com
GATEWAY_PUBLIC_URL=https://chat.neetrino.com

# ── Database (Neon Postgres) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Secrets ────────────────────────────────────────────────────────────────────
# Each secret must be at least 32 characters of high-entropy random data.
COOKIE_SECRET=replace-with-32+char-random-string
JWT_SECRET=replace-with-32+char-random-string
TOKEN_PEPPER=replace-with-32+char-random-string

# ── WAHA ───────────────────────────────────────────────────────────────────────
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=replace-with-waha-api-key
# Deprecated and ignored. Database WhatsappAccount.sessionName is the WAHA session.
# WAHA_SESSION_NAME=
# Consumed by the WAHA container (compose `waha` service), not by the Gateway process.
WHATSAPP_DEFAULT_ENGINE=NOWEB
WAHA_WEBHOOK_SECRET=replace-with-webhook-secret

# ── API token format ───────────────────────────────────────────────────────────
API_TOKEN_PREFIX=gw_live

# ── Limits ─────────────────────────────────────────────────────────────────────
MAX_TEXT_LENGTH=4096
MAX_CAPTION_LENGTH=4096
MAX_CHATS_PAGE=100
MAX_MESSAGES_PAGE=100
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
RATE_LIMIT_SEND=60
# v1 Project-token API. Tracked by HMAC(token)+TOKEN_PEPPER, not the raw token. IP fallback if no Bearer.
RATE_LIMIT_V1_SEND=60
RATE_LIMIT_V1_READ=120
# Stale PROCESSING idempotency records older than this become OUTCOME_UNKNOWN (not retryable).
IDEMPOTENCY_PROCESSING_TIMEOUT_MS=120000

# ── Initial admin (used by `npm run prisma:seed`) ──────────────────────────────
# Seed creates or updates the singleton Admin only. It does not create a WhatsApp account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
